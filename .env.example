# Base URL for hero frames 21-483 hosted on Cloudflare R2.
# Frames 1-20 always ship locally from public/video_frames/ and ignore this value.
# No trailing slash required; it is normalised by src/components/HeroCanvas/frameSource.ts.
VITE_HERO_FRAME_CDN_BASE=https://storage.lovetwee.com/static/profile/frames
